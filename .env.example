# Copy to .env and fill in once an ArcGIS service account exists (PRD R6).
# Leave blank to keep the backend in mock-data mode.
ARCGIS_PORTAL_URL=
ARCGIS_USERNAME=
ARCGIS_PASSWORD=

# Comma-separated list is NOT supported here; edit CORS_ORIGINS as a
# Python-list-literal-shaped env var is awkward, so this is set directly
# in app/config.py for now. Adjust there if the frontend runs on a
# different origin than http://localhost:5173.
